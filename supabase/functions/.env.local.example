# Local edge-function secrets. Copy to `.env.local` (git-ignored) and fill in.
# `supabase functions serve` reads this; SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY
# are injected automatically by the local stack, so they are NOT listed here.

# Shared secret verified by every function; must match the `serverless_secret`
# vault entry seeded by seed.sql (locally that value is "local-dev-secret").
SERVERLESS_SECRET=local-dev-secret

# Firebase service account (refresh-fcm-token mints FCM access tokens). From the
# service account JSON: client_email, private_key (keep the literal \n), project_id.
# Firebase service account credentials — only the fields used by refresh-fcm-token.
# Source: Firebase Console → Project Settings → Service accounts → Generate new private key.
# Copy client_email and private_key from the downloaded JSON file.
# Without these, refresh-fcm-token fails and push notifications are silently skipped locally.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_PROJECT_ID=
