# Local edge-function secrets. Copy to `.env.local` (git-ignored) and fill in.
# `supabase functions serve` reads this; SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY
# are injected automatically by the local stack, so they are NOT listed here.

# Shared secret verified by every function; must match the `serverless_secret`
# vault entry seeded by seed.sql (locally that value is "local-dev-secret").
SERVERLESS_SECRET=local-dev-secret

# Master secret for server-bot auth. Each bot's HMAC key is derived as
# HMAC(BOT_SIGNING_SECRET, bot_id), used by the `game` function to verify bot
# actions and sign bot wakes (_engine/bot_auth.ts). Any non-empty value works
# locally; only needed when testing server bots.
BOT_SIGNING_SECRET=local-dev-bot-secret

# Firebase service account — the `game` function mints FCM access tokens from
# these (_engine/fcm.ts) to send push notifications. From the service account
# JSON: client_email, private_key (keep the literal \n), project_id.
# Source: Firebase Console → Project Settings → Service accounts → Generate new private key.
# Without these, push notifications are silently skipped locally.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_PROJECT_ID=
